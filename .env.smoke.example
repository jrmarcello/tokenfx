# .env.smoke — generated by `pnpm smoke:seed`. DO NOT COMMIT.
# Plaintext smoke reporter bearer secret + project secret.
# Source via `source .env.smoke && pnpm reporter:once` for cross-stack tests.

# Plaintext bearer secret (matches the bcrypt-hashed value in user_machines.secret_hash).
REPORTER_BEARER_SECRET=<32-byte-hex>

# HMAC project secret (per-session payload signature key).
REPORTER_PROJECT_SECRET=<32-byte-hex>

# Bearer key_id matching user_machines.key_id seeded for smoke-user-1.
REPORTER_KEY_ID=key-smoke-001

# Reporter target — the apps/server ingest endpoint, host-published port.
REPORTER_TARGET_URL=http://localhost:3232/api/ingest
