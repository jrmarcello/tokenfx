# Build artifacts — `**` matches at any depth. Required because root-level
# patterns (`node_modules`) only match the build-context root, NOT nested
# ones like `apps/server/node_modules` or `apps/idp-stub/node_modules`,
# which on the host would otherwise be baked into the COPY layer and
# corrupt `pnpm install` inside the image (silently reusing partial host
# node_modules instead of installing fresh).
**/.next
**/node_modules
**/dist

# Runtime data (mounted as volume — never baked into image)
data

# VCS
.git
.gitignore

# Dev-only tooling / specs
.claude
.specs
.ralph

# Tests (run on host, not in image)
tests
playwright.config.ts
playwright-report
test-results

# Editor / OS cruft
.vscode
.idea
.DS_Store

# Env files — must NEVER end up in the image.
# Keep .env.example if/when it exists so the build can copy it.
.env
.env.*
!.env.example

# Logs / temp
*.log
tmp
